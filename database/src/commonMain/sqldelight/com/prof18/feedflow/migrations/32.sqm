CREATE VIRTUAL TABLE IF NOT EXISTS reading_history_search USING FTS4(
    feed_item_id TEXT NOT NULL,
    title TEXT,
    summary TEXT,
    author TEXT,
    feed_source_title TEXT,
    article_text TEXT,
    tokenize=unicode61 "tokenchars=+#"
);

CREATE TRIGGER IF NOT EXISTS populate_reading_history_search
AFTER INSERT ON reading_history
BEGIN
    DELETE FROM reading_history_search WHERE feed_item_id = new.feed_item_id;
    INSERT INTO reading_history_search(
        feed_item_id, title, summary, author, feed_source_title, article_text
    ) VALUES (
        new.feed_item_id, new.title, new.summary, new.author, new.feed_source_title, new.article_text
    );
END;

CREATE TRIGGER IF NOT EXISTS update_reading_history_search
AFTER UPDATE ON reading_history
BEGIN
    DELETE FROM reading_history_search WHERE feed_item_id = new.feed_item_id;
    INSERT INTO reading_history_search(
        feed_item_id, title, summary, author, feed_source_title, article_text
    ) VALUES (
        new.feed_item_id, new.title, new.summary, new.author, new.feed_source_title, new.article_text
    );
END;

CREATE TRIGGER IF NOT EXISTS delete_reading_history_search
BEFORE DELETE ON reading_history
BEGIN DELETE FROM reading_history_search WHERE feed_item_id = old.feed_item_id;
END;

INSERT INTO reading_history_search(
    feed_item_id, title, summary, author, feed_source_title, article_text
)
SELECT feed_item_id, title, summary, author, feed_source_title, article_text
FROM reading_history;
